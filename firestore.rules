rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuario autenticado solo puede leer/escribir su propio documento de progreso
    match /appopo/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Ranking: cualquier usuario autenticado puede leer la lista, pero cada uno solo
    // puede escribir su propia fila (alias y puntuación), nunca las de otros.
    match /rankings/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
